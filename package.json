{
  "name": "coursepilot-ai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "An AI-powered learning SaaS focused on guided reasoning, progressive hints, and course-grounded tutoring.",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=11.0.0"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @coursepilot/web --filter @coursepilot/api --filter @coursepilot/worker dev",
    "build": "pnpm --recursive build",
    "typecheck": "pnpm --recursive typecheck",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "pnpm --recursive test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "pnpm --recursive clean",
    "infra:up": "docker compose up -d postgres redis mailpit",
    "infra:stop": "docker compose stop postgres redis mailpit",
    "docker:build": "docker compose build web api worker",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "db:generate": "pnpm --filter @coursepilot/database prisma:generate",
    "verify": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^16.5.0",
    "prettier": "^3.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.65.0"
  }
}
