{
  "name": "@coursepilot/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/worker.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit --pretty false",
    "lint": "eslint src tests",
    "test": "vitest run --passWithNoTests",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@coursepilot/config": "workspace:*",
    "@coursepilot/queue": "workspace:*",
    "bullmq": "^5.0.0",
    "dotenv": "^17.0.0",
    "pino": "^9.0.0",
    "pino-pretty": "^13.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "eslint": "^9.0.0",
    "tsx": "^4.0.0",
    "typescript": "~5.9.0",
    "vitest": "^4.1.10"
  }
}
